    { "label": "aircraft", "text": "an airplane or helicopter overhead" },
    { "label": "construction", "text": "construction work, drilling and hammering" },
    { "label": "crowd", "text": "a crowd of people talking together" },
    { "label": "speech", "text": "a person speaking" },
    { "label": "shouting", "text": "someone shouting or yelling" },
    { "label": "laughter", "text": "people laughing" },
    { "label": "children playing", "text": "children playing and shouting" },
