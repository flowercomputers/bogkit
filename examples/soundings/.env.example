# Soundings — environment. Copy to `.env` at the repo root (or set real env
# vars; those always win). Everything here is OPTIONAL: the instrument runs
# fully local with no keys at all.

# ---- the one API key ----
# Powers the precision rewrites ("more concrete", "pull toward this voice").
# Without it the targeting UI and receipts still render — only drafting is
# disabled, with an honest "needs a model" state. Also found automatically in
# ~/.loupe-env or ~/Documents/GitHub/loupe/.env if you have those.
OPENAI_API_KEY=

# Which guest model drafts the rewrites (the lenses verify it either way).
#LLM_MODEL=gpt-5.6-sol

# ---- knobs (no keys) ----
# Port for the instrument (default 4600).
#SOUNDINGS_PORT=4600
# Canon sampling: every Nth sentence of the 129k canon (default 10). Set 1
# for the full canon — one ~3min index build, instant ever after.
#SOUNDINGS_CANON_STEP=10
# Start with a blank document instead of the seeded demo doc.
#SOUNDINGS_NO_SEED=1
